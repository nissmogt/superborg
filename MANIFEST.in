# sdist: the C engine sources are needed to compile the library at install time
include Makefile README.md setup.py pyproject.toml
recursive-include engine *.c *.h
recursive-include docs *.md
recursive-include superborg/data *
recursive-include superborg/web *.html
prune superborg/_lib
global-exclude *.o *.so *.dylib *.dll __pycache__ *.pyc
